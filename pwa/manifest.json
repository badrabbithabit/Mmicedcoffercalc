/**
 * manifest.json — PWA Manifest
 *
 * This file enables the app to be installed to the home screen
 * on iOS Safari and Android. The browser/OS reads this file
 * to determine app behavior.
 *
 * Key fields:
 *   name/short_name  : Displayed on home screen & install dialog
 *   start_url        : URL opened when launching from home screen
 *   display          : 'standalone' = no browser chrome (app-like)
 *   scope            : '/' = all URLs under root are handled
 *   lang             : App language
 *   icons            : SVG icon for home screen icon
 *
 * ── iOS Safari PWA Setup ───────────────────────────────────────
 * iOS Safari requires:
 *   1. manifest.json with display=standalone
 *   2. <meta name="apple-mobile-web-app-capable" content="yes"> in HTML
 *   3. <meta name="apple-mobile-web-app-status-bar-style" in HTML
 *   4. Touch icon (180x180px PNG recommended, SVG works too)
 *   5. Site must be served over HTTPS (or localhost for dev)
 *
 * To install: Open in Safari → tap Share → "Add to Home Screen"
 */
{
  "name": "Coffee Ratio Calculator",
  "short_name": "Coffee Ratio",
  "description": "Japanese Iced Coffee ratio calculator for Moccamaster",
  "start_url": "./index.html",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "fullscreen"],
  "orientation": "portrait",
  "scope": "./",
  "lang": "en",
  "categories": ["food", "utilities"],
  "icons": [
    {
      "src": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 192 192'%3E%3Crect width='192' height='192' fill='%236b7c66' rx='32'/%3E%3Ctext x='96' y='128' font-size='80' text-anchor='middle' fill='white'%3E%E2%98%95%3C/text%3E%3C/svg%3E",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
